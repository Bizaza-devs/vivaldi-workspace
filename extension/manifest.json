{
  "manifest_version": 3,
  "name": "Gemini Panel",
  "version": "0.1.0",
  "description": "Letisztult Gemini-chat a böngésző mellett: oldal és kijelölés kérdezése, automatikus modellválasztás.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Gemini Panel (Alt+G)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "contextMenus", "scripting", "activeTab", "sidePanel"],
  "host_permissions": ["https://generativelanguage.googleapis.com/*"],
  "optional_host_permissions": ["<all_urls>"],
  "side_panel": {
    "default_path": "panel.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+G" },
      "description": "Gemini Panel megnyitása"
    }
  }
}
